{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ploos Publishing QA Review Run",
  "type": "object",
  "required": ["format_version", "project", "source_digest", "findings", "reviewers", "required_failures", "complete"],
  "properties": {
    "format_version": {"const": 1},
    "project": {"type": "string"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "reviewers": {"type": "array", "items": {"type": "object"}},
    "required_failures": {"type": "array", "items": {"type": "string"}},
    "complete": {"type": "boolean"}
  },
  "additionalProperties": false
}
