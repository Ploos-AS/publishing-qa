{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "qa_version",
    "project"
  ],
  "properties": {
    "qa_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "primary_language",
        "languages"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "primary_language": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frontmatter_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "ai": {
      "type": "object",
      "properties": {
        "independent_reviews": {
          "type": "boolean"
        },
        "reviewers": {
          "type": "object",
          "properties": {
            "required": {
              "$ref": "#/$defs/reviewers"
            },
            "supplemental": {
              "$ref": "#/$defs/reviewers"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "properties": {
        "max_blocker": {
          "type": "integer",
          "minimum": 0
        },
        "max_critical": {
          "type": "integer",
          "minimum": 0
        },
        "max_high": {
          "type": "integer",
          "minimum": 0
        },
        "require_deterministic_tests": {
          "type": "boolean"
        },
        "require_build": {
          "type": "boolean"
        },
        "require_human_approval": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "producers": {
          "type": "array"
        },
        "bindings": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
